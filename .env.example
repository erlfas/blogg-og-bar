CSRF_TRUSTED_ORIGINS=https://blottogbar.no,https://www.blottogbar.no,http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (Set USE_SQLITE=True to use local SQLite)
USE_SQLITE=True
# PostgreSQL production settings (used when USE_SQLITE=False)
DB_NAME=blottogbar
